PORT=3000
DATABASE_URL="file:./dev.db"
# Shared secret for n8n → portal API (Authorization: Bearer <key>)
PORTAL_API_KEY="replace-with-long-random-secret"
# Comma-separated admin emails allowed to use the dashboard (fallback if admin-api unreachable)
ADMIN_EMAILS="shreyas@powerhousetech.in"
FIREBASE_WEB_API_KEY="your-firebase-web-api-key"
# Optional: verify is_admin via existing PowerhouseTech admin-api
ADMIN_API_URL="https://msratyvmnuvozuthgkmi.supabase.co/functions/v1/admin-api?op=me"

# n8n webhook base URL (e.g. https://shreyas-sinha.app.n8n.cloud/webhook)
N8N_WEBHOOK_BASE_URL=https://shreyas-sinha.app.n8n.cloud/webhook
# Webhook paths (match the paths set inside the n8n workflow nodes)
N8N_DISCOVER_PATH=outreach-discover
N8N_MAIL_PATH=outreach-mail

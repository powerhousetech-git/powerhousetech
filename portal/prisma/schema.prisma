generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Contact {
  id              String     @id @default(uuid())
  name            String
  firstName       String
  lastName        String
  email           String?
  company         String?
  domain          String
  title           String?
  country         String?
  track           String? // "Track A - Startups" | "Track B - EMS"
  status          String     @default("Queue")
  source          String?    @default("Apollo")
  allPermutations String?
  // Legacy timestamps kept for backwards compatibility
  day1SentAt      DateTime?
  day4SentAt      DateTime?
  day9SentAt      DateTime?
  /// Map of follow-up number → ISO timestamp, e.g. {"1":"...","2":"..."}
  followUpDates   Json?
  repliedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  emailLogs       EmailLog[]

  @@unique([domain, name])
  @@index([status])
  @@index([email])
}

/// Single-row cadence config (id = 1). Exactly 10 slots; null = inactive.
model OutreachConfig {
  id          Int      @id @default(1)
  cadenceDays Json     @default("[1,4,9,null,null,null,null,null,null,null]")
  updatedAt   DateTime @updatedAt
}

model EmailLog {
  id          Int      @id @default(autoincrement())
  contactId   String
  followUpNum Int // 1 = initial, 2 = first follow-up, …
  track       String?
  sentAt      DateTime @default(now())
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([sentAt])
  @@index([followUpNum])
  @@index([track])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Contact {
  id              String    @id @default(uuid())
  name            String
  firstName       String
  lastName        String
  email           String?
  company         String?
  domain          String
  title           String?
  country         String?
  track           String? // "Track A - Startups" | "Track B - EMS"
  status          String    @default("Queue")
  source          String?   @default("Apollo")
  allPermutations String?
  day1SentAt      DateTime?
  day4SentAt      DateTime?
  day9SentAt      DateTime?
  repliedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([domain, name])
  @@index([status])
  @@index([email])
}

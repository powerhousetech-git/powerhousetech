# ─────────────────────────────────────────────────────────────
# Harshul Tiles & Fittings — Dashboard (read-only monitor)
# Copy to `.env.local` and fill in real values.
#
# The dashboard runs in DEMO MODE (seeded fixtures + open access) until the
# Google + auth variables below are provided:
#   • No GOOGLE_SERVICE_ACCOUNT_KEY → data comes from in-memory demo fixtures
#   • No GOOGLE_CLIENT_ID/SECRET    → the Google-OAuth gate is bypassed
# ─────────────────────────────────────────────────────────────

# Google Sheets (read-only). Paste the service-account JSON as a single line.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account", ... }
# Optional override; defaults to the Harshul sheet baked into the code.
SHEET_ID=1BbtJp8j0HxFVxvEdyakjk8P4FMUL3l-FyJrgR2IO6mY

# NextAuth (Google OAuth, restricted to the owner)
NEXTAUTH_SECRET=change-me-to-a-long-random-string
NEXTAUTH_URL=https://harshul.powerhousetech.in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL=harshul@example.com

# Evolution API (WhatsApp gateway — health check only)
# One-click managed deploy (Render/Railway, no VPS): see deploy/evolution/README.md
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=harshul

# n8n (status links)
N8N_BASE_URL=https://shreyas-sinha.app.n8n.cloud

# ─────────────────────────────────────────────────────────────
# Harshul Tiles & Fittings — Dashboard environment variables
# Copy to `.env.local` and fill in real values.
# The dashboard runs in DEMO MODE (seeded fixture data) until
# GOOGLE_SERVICE_ACCOUNT_KEY + SPREADSHEET_ID are provided.
# ─────────────────────────────────────────────────────────────

# Google Sheets (Phase 1 data source)
# Path to a service-account JSON key file, OR paste the raw JSON directly.
GOOGLE_SERVICE_ACCOUNT_KEY=./service-account.json
SPREADSHEET_ID=

# Evolution API (WhatsApp gateway — status checks only)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=harshul

# n8n Webhooks (the automation engine actually sends messages)
N8N_WEBHOOK_BASE=http://localhost:5678/webhook
N8N_MARK_DONE_PATH=/hrs-mark-done
N8N_SEND_NOW_PATH=/hrs-send-now
N8N_STATS_PATH=/hrs-stats

# Auth — simple password gate (just 3-5 users)
DASHBOARD_PASSWORD=harshul123

# Business
BUSINESS_NAME=Harshul Tiles & Fittings
GOOGLE_REVIEW_URL=https://g.page/r/your-review-link

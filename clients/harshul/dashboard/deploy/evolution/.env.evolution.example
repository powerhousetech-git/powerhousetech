# ─────────────────────────────────────────────────────────────
# Evolution API v2 — environment reference
#
# On Render/Railway these are set for you by the blueprint/template
# (see render.yaml). This file documents every value and is handy for
# a local `docker run`/compose fallback.
# ─────────────────────────────────────────────────────────────

# ── Server ──
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=https://your-evolution-host            # public https URL of the service
CORS_ORIGIN=*
LOG_LEVEL=ERROR
DEL_INSTANCE=false

# ── Auth ──
# This is the value the dashboard/n8n use as EVOLUTION_API_KEY.
AUTHENTICATION_TYPE=apikey
AUTHENTICATION_API_KEY=change-me-to-a-long-random-string

# ── Database (PostgreSQL) ──
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:PASSWORD@postgres:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=evolution_harshul
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true

# ── Cache (Redis) ──
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379
CACHE_REDIS_PREFIX_KEY=evolution_harshul
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# ── WhatsApp session identity ──
CONFIG_SESSION_PHONE_CLIENT=Harshul Tiles
CONFIG_SESSION_PHONE_NAME=Chrome

# ── Webhooks (n8n registers per-instance; keep global off) ──
WEBHOOK_GLOBAL_ENABLED=false

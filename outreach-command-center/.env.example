# --- PowerhouseTech Outreach Command Center ---
#
# Secrets are NOT in the browser bundle. They live only in the serverless
# functions' environment (Netlify dashboard). The frontend uses non-secret
# VITE_ vars plus the /api/* proxy.

# ================================================================
# SERVER-SIDE (set these in Netlify → Site configuration → Environment variables).
# Do NOT prefix these with VITE_ and do NOT put them in the client build.
# ================================================================
# APP_PASSWORD=choose-a-strong-shared-password
# GOOGLE_SERVICE_ACCOUNT_JSON=base64_encoded_service_account_json
# N8N_API_KEY=your_n8n_api_key
# SPREADSHEET_ID=1l-Mg8QEw90EfKUMQZgCKmKy2Jr4iX8JH3ur0rnw6MOM
# N8N_BASE_URL=https://shreyas-sinha.app.n8n.cloud
#
# For local dev with real data, use `netlify dev` and put the same values in a
# local `.env` (they are read by the functions, not the browser).

# ================================================================
# CLIENT-SIDE (safe, non-secret) — used by the Vite frontend.
# ================================================================
VITE_SPREADSHEET_ID=1l-Mg8QEw90EfKUMQZgCKmKy2Jr4iX8JH3ur0rnw6MOM
VITE_N8N_BASE_URL=https://shreyas-sinha.app.n8n.cloud
VITE_N8N_INDIA_WORKFLOW_ID=yrYIauoO1q46DORb
VITE_N8N_US_WORKFLOW_ID=41O5a05zrxyWqpe2

# Optional: preview the whole UI with sample data (skips login + all network).
# VITE_USE_MOCK_DATA=false

# Optional: override tab names if different from the defaults.
# VITE_SHEET_INDIA=India Leads
# VITE_SHEET_US=US Leads
# VITE_SHEET_EMAIL_LOG=Email Log

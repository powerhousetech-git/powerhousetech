# --- PowerhouseTech Outreach Command Center ---
# Copy this file to `.env` and fill in the two secret values. Never commit `.env`.

# Google Spreadsheet that holds "India Leads", "US Leads", "Email Log".
VITE_SPREADSHEET_ID=1l-Mg8QEw90EfKUMQZgCKmKy2Jr4iX8JH3ur0rnw6MOM

# Google Service Account JSON key (read + write access to the sheet above),
# base64-encoded as a single line:
#   Linux:  base64 -w0 service-account.json
#   macOS:  base64 -i service-account.json | tr -d '\n'
VITE_GOOGLE_SERVICE_ACCOUNT_JSON=base64_encoded_service_account_json

# n8n cloud instance + workflow IDs.
VITE_N8N_BASE_URL=https://shreyas-sinha.app.n8n.cloud
VITE_N8N_API_KEY=your_n8n_api_key_here
VITE_N8N_INDIA_WORKFLOW_ID=yrYIauoO1q46DORb
VITE_N8N_US_WORKFLOW_ID=41O5a05zrxyWqpe2

# --- Optional ---
# Preview the whole UI with built-in sample data (no Google/n8n setup needed).
# Set to "true" to enable. Leave unset/false for real data.
# VITE_USE_MOCK_DATA=false

# Override the exact tab (sheet) names if yours differ from the defaults.
# VITE_SHEET_INDIA=India Leads
# VITE_SHEET_US=US Leads
# VITE_SHEET_EMAIL_LOG=Email Log

# --- PowerhouseTech Outreach Command Center ---
#
# Served on the MAIN powerhousetech Netlify site at /command-center, gated by the
# site's Google admin sign-in (Supabase is_admin, e.g. shreyas@powerhousetech.in).
# There is NO separate password and NO separate site.
#
# Secrets are NOT in the browser bundle. They live only in the Supabase Edge
# Function `command-center` (supabase/functions/command-center), same platform as
# the site's other backends (admin-api, outreach-api).

# ================================================================
# SERVER-SIDE (Supabase → Edge Function secrets, via `supabase secrets set`).
# Do NOT prefix with VITE_ and do NOT put in the client build.
# All are CC_-prefixed so they never collide with other functions' project-wide
# secrets (e.g. ps2-lead-api uses N8N_API_KEY, outreach-api uses ADMIN_EMAILS).
# ================================================================
# CC_GOOGLE_SERVICE_ACCOUNT_JSON=base64_encoded_service_account_json  (Editor on the sheet)
# CC_N8N_API_KEY=your_n8n_api_key
# CC_SPREADSHEET_ID=1l-Mg8QEw90EfKUMQZgCKmKy2Jr4iX8JH3ur0rnw6MOM
# CC_N8N_BASE_URL=https://shreyas-sinha.app.n8n.cloud
# CC_ADMIN_EMAILS=shreyas@powerhousetech.in,yash@powerhousetech.in
# Optional: live Apollo credit balance for Populate preview (falls back to APOLLO_API_KEY / APOLLO_KEY_1)
# CC_APOLLO_API_KEY=your_apollo_api_key
# Optional webhook path overrides (JSON map workflowId → path or absolute URL):
# CC_N8N_WEBHOOKS={"c2JyDKolZaIhUlzs":"run-india-outreach-v2","fHFG8B2mhToK6bid":"run-us-outreach-v2","lMK8RlkBJS4V8aAH":"run-apollo-discovery"}

# ================================================================
# CLIENT-SIDE (safe, non-secret) — used by the Vite frontend.
# ================================================================
VITE_SPREADSHEET_ID=1l-Mg8QEw90EfKUMQZgCKmKy2Jr4iX8JH3ur0rnw6MOM
VITE_N8N_BASE_URL=https://shreyas-sinha.app.n8n.cloud
VITE_N8N_INDIA_WORKFLOW_ID=c2JyDKolZaIhUlzs
VITE_N8N_US_WORKFLOW_ID=fHFG8B2mhToK6bid
VITE_N8N_APOLLO_WORKFLOW_ID=lMK8RlkBJS4V8aAH
VITE_N8N_INDIA_TRIGGER_NODE=Daily 8:30 AM IST (Mon-Sat)
VITE_N8N_US_TRIGGER_NODE=Daily 10 AM ET (Mon-Fri)

# Optional: preview the whole UI with sample data (skips the admin gate + network).
# VITE_USE_MOCK_DATA=false

# Optional: override the backend proxy URL (for local `supabase functions serve`).
# VITE_COMMAND_CENTER_API=https://msratyvmnuvozuthgkmi.supabase.co/functions/v1/command-center

# Optional: override tab names if different from the defaults.
# VITE_SHEET_INDIA=India Leads
# VITE_SHEET_US=US Leads
# VITE_SHEET_EMAIL_LOG=Email Log
# VITE_SHEET_SETTINGS=Settings

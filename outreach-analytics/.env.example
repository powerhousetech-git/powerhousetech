# --- PowerhouseTech Outreach Analytics Dashboard ---
# Copy this file to `.env` and fill in the values. Never commit your real `.env`.

# The ID of the Google Spreadsheet that holds the "India Leads", "US Leads",
# and "Email Log" tabs. It is the long string in the sheet URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
VITE_SPREADSHEET_ID=your_spreadsheet_id_here

# A Google Service Account JSON key (read-only access to the sheet above),
# base64-encoded as a single line.
#   macOS/Linux:  base64 -w0 service-account.json   (macOS: base64 -i service-account.json)
#   or:           cat service-account.json | base64 | tr -d '\n'
VITE_GOOGLE_SERVICE_ACCOUNT_JSON=base64_encoded_service_account_json

# Optional: preview the dashboard with built-in sample data (no Google setup
# required). Set to "true" to enable. Leave unset/false for real data.
# VITE_USE_MOCK_DATA=false

# Optional: override the exact tab (sheet) names if yours differ from the defaults.
# Defaults are shown below.
# VITE_SHEET_INDIA=India Leads
# VITE_SHEET_US=US Leads
# VITE_SHEET_EMAIL_LOG=Email Log

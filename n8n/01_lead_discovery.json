    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const trackLetter = 'A';\nconst trackToSlug = 'saas-startups';\nconst trackToLabel = 'Track A - Startups';\n\nconst resp = $input.first().json;\nconst people = resp.people || resp.contacts || [];\nif (!people.length) return [{ json: { _empty: true } }];\n\nreturn people.map((p) => {\n  const org = p.organization || {};\n  const first = p.first_name || (p.name ? p.name.split(' ')[0] : '') || '';\n  const last = p.last_name || (p.name ? p.name.split(' ').slice(1).join(' ') : '') || '';\n  const domain = String(org.primary_domain || org.website_url || '')\n    .replace(/^https?:\\/\\//, '')\n    .replace(/\\/.*$/, '')\n    .toLowerCase();\n\n  return {\n    json: {\n      name: p.name || `${first} ${last}`.trim(),\n      firstName: first,\n      lastName: last,\n      email: p.email || '',\n      company: org.name || p.organization_name || '',\n      domain,\n      title: p.title || '',\n      country: p.country || p.city || '',\n      track: trackToLabel,\n      industrySlug: trackToSlug,\n      trackLetter,\n    },\n  };\n});"
      },
